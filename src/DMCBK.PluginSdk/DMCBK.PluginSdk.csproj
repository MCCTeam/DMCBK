<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><Description>Author contracts, sessions, versioned manifests and plugin communication.</Description>
    <RootNamespace>DMCBK.PluginSdk</RootNamespace>
    <AssemblyName>DMCBK.PluginSdk</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>DMCBK.PluginSdk</PackageId>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="SDK-CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DMCBK.Core/DMCBK.Core.csproj" />
    <PackageReference Include="Umpk.Client" />
    <PackageReference Include="Umpk.Text" />
    <PackageReference Include="Umpk.Core" />
    <PackageReference Include="Umpk.Data.Java" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Samboy063.Tomlet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DMCBK.Core.Tests" />
    <InternalsVisibleTo Include="DMCBK.Testing" />
    <InternalsVisibleTo Include="DMCBK.Plugins"/>
    <InternalsVisibleTo Include="DMCBK.Marketplace"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
<ItemGroup><InternalsVisibleTo Include="DMCBK.OfficialPlugins.Tests"/><InternalsVisibleTo Include="Mcc.Cli.Tests"/></ItemGroup>
</Project>
